{
  "name": "rastreio-rodonaves",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Monitor Rodonaves e Trans Vales com notificações privadas no Telegram",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.js run",
    "start:cloud": "node src/cli.js run --cloud",
    "test": "node --test test/*.test.js",
    "once": "node src/cli.js once",
    "status": "node src/cli.js status",
