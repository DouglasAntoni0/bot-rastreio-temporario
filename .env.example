# Copie para .env no PC. Na Discloud, preencha as variáveis privadas no painel.
TELEGRAM_BOT_TOKEN=SUBSTITUA_PELO_TOKEN_DO_BOTFATHER
TELEGRAM_CHAT_ID=123456789
# Identificadores fictícios. Substitua pelos dados da sua encomenda.
RODONAVES_PROTOCOLO=900000001
RODONAVES_CTE=900000002
RODONAVES_CNPJ=00000000000000
RODONAVES_NF=999991
# Opcionais. Na nuvem, ative a SSW preenchendo as duas variáveis.
# SSW_CPF=00000000000
# SSW_NF=999992
CHECK_INTERVAL_MS=300000
# Necessárias para hospedagem e operações com o histórico remoto.
UPSTASH_REDIS_REST_URL=https://exemplo.upstash.io
UPSTASH_REDIS_REST_TOKEN=SUBSTITUA_PELO_TOKEN_STANDARD
STATE_NAMESPACE=rodonaves
